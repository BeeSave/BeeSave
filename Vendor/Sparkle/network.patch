+    if (data.length > BeeSaveFeedLimit - _temporaryData.length) {
+        [self failDownload:[self downloadPolicyError:@"The update feed exceeds 1 MiB."]];
+        return;
+    }
+    [_temporaryData appendData:data];
 }
 
